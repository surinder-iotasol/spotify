# Indie Music Streaming Platform — Environment Variables
# Copy this file to .env.local (gitignored) and fill in real values.

# Database
DATABASE_URL=mongodb://localhost:27017/indie_platform

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-string

# AWS / S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEKEY
AWS_SECRET_ACCESS_KEY=exampleSecretAccessKey1234567890abcdefghijklmn
S3_BUCKET_NAME=indie-platform-assets
S3_ENDPOINT=http://localhost:9000
